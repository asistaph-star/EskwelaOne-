# ============================================================
# DigiSkwela Backend — Environment Configuration
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env with real credentials.
# ============================================================

# --- Database ---
DATABASE_URL="postgresql://digiskwela:digiskwela@localhost:5432/digiskwela?schema=public"

# --- Authentication ---
JWT_SECRET="CHANGE_ME_TO_A_STRONG_RANDOM_SECRET_MIN_32_CHARS"
JWT_EXPIRES_IN="8h"

# --- Server ---
PORT=4000
CORS_ORIGIN="http://localhost:5173"
NODE_ENV="development"

# --- Object Storage (S3-compatible) ---
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="digiskwela-documents"
S3_ACCESS_KEY="CHANGE_ME"
S3_SECRET_KEY="CHANGE_ME"
S3_PRESIGNED_EXPIRY_SECONDS=300
