  correction_reason String?                  @db.VarChar(500)
  created_at        DateTime                 @default(now())
  updated_at        DateTime                 @updatedAt

  // Composite FK enforces at DB level that enrollment_id matches student_id, section_id, and academic_year_id
  enrollment        Enrollment               @relation(fields: [enrollment_id, student_id, section_id, academic_year_id], references: [id, student_id, section_id, academic_year_id], onDelete: Restrict)
  student           Student                  @relation(fields: [student_id], references: [id], onDelete: Restrict)
  section           Section                  @relation(fields: [section_id, academic_year_id], references: [id, academic_year_id], onDelete: Restrict)
  academic_year     AcademicYear             @relation(fields: [academic_year_id], references: [id], onDelete: Restrict)
  recorded_by       User                     @relation("AdviserCommentRecorder", fields: [recorded_by_id], references: [id], onDelete: Restrict)
  updated_by        User?                    @relation("AdviserCommentUpdater", fields: [updated_by_id], references: [id], onDelete: Restrict)
  published_by      User?                    @relation("AdviserCommentPublisher", fields: [published_by_id], references: [id], onDelete: Restrict)

  @@unique([enrollment_id, term])
  @@index([enrollment_id, status])
  @@index([student_id, academic_year_id, status])
  @@index([section_id, academic_year_id, term, status])
  @@map("sf9_adviser_comments")
}

model Sf9OfficialIssuance {
  id                           String                @id @db.VarChar(36)
  enrollment_id                String                @db.VarChar(36)
  student_id                   String                @db.VarChar(36)
  section_id                   String                @db.VarChar(36)
  academic_year_id             String                @db.VarChar(36)
  version                      Int                   @default(1)
  is_current                   Boolean               @default(true)
  /// @encrypted?mode=strict
  frozen_payload_encrypted     String                @db.Text
  /// @encrypted?mode=strict
  calculated_summary_encrypted String                @db.Text
  template_sha256              String                @db.VarChar(64)
  xlsx_sha256                  String                @db.VarChar(64)
  pdf_sha256                   String                @db.VarChar(64)
  libreoffice_version          String                @db.VarChar(100)
  issued_pdf_document_id       String?               @db.VarChar(36)
  adviser_teacher_id           String                @db.VarChar(36)
  adviser_name                 String                @db.VarChar(150)
  school_head_name             String                @db.VarChar(150)
  school_head_title            String                @db.VarChar(100)
  issued_by_id                 String                @db.VarChar(36)
  issued_at                    DateTime              @default(now())
  superseded_by_id             String?               @db.VarChar(36)
  correction_reason            String?               @db.VarChar(500)

  // Composite FK enforces at DB level that enrollment_id matches student_id, section_id, and academic_year_id
  enrollment                   Enrollment            @relation(fields: [enrollment_id, student_id, section_id, academic_year_id], references: [id, student_id, section_id, academic_year_id], onDelete: Restrict)
  student                      Student               @relation(fields: [student_id], references: [id], onDelete: Restrict)
  section                      Section               @relation(fields: [section_id, academic_year_id], references: [id, academic_year_id], onDelete: Restrict)
  academic_year                AcademicYear          @relation(fields: [academic_year_id], references: [id], onDelete: Restrict)
  adviser_teacher              Teacher               @relation("Sf9IssuanceAdviser", fields: [adviser_teacher_id], references: [id], onDelete: Restrict)
  issued_pdf_document          Document?             @relation("IssuedSf9PdfDocument", fields: [issued_pdf_document_id], references: [id], onDelete: Restrict)
  issued_by                    User                  @relation("Sf9IssuanceIssuer", fields: [issued_by_id], references: [id], onDelete: Restrict)
  superseded_by                Sf9OfficialIssuance?  @relation("SupersededSf9Issuance", fields: [superseded_by_id], references: [id], onDelete: Restrict)
  supersedes                   Sf9OfficialIssuance[] @relation("SupersededSf9Issuance")

  @@unique([enrollment_id, version])
  @@index([enrollment_id, is_current])
  @@index([student_id, academic_year_id, is_current])
  @@map("sf9_official_issuances")
}
