generator client {
  provider        = "prisma-client-js"
  output          = "../../src/generated/sf2Sf9TestClient"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("TEST_DATABASE_URL")
  extensions = [pgcrypto]
}

model User {
  id                             String                @id @db.VarChar(36)
  school_id                      String                @unique @default(cuid()) @db.VarChar(100)
  email                          String?               @unique @db.VarChar(255)
  password_hash                  String                @db.VarChar(255)
  first_name                     String                @db.VarChar(100)
  last_name                      String                @db.VarChar(100)
  middle_name                    String?               @db.VarChar(100)
  status                         String                @default("active") @db.VarChar(20)
  created_at                     DateTime              @default(now())
  updated_at                     DateTime              @updatedAt
  must_change_password           Boolean               @default(false)
  announcements                  Announcement[]
  audit_logs                     AuditLog[]
  ai_audit_logs                  AIAuditLog[]
  behaviorLogs                   BehaviorLog[]
  clinic_referrals_recorded      ClinicReferral[]
  document_requests_approved     DocumentRequest[]     @relation("PrincipalApprover")
  documents_uploaded             Document[]
  events                         Event[]
  grade_entries_created          grade_entries[]
  guidance_records_counseled     GuidanceRecord[]
  inventoryUpdates               InventoryUpdate[]
  leave_requests_approved        LeaveRequest[]        @relation("LeaveApprover")
  leave_requests_made            LeaveRequest[]        @relation("LeaveRequester")
  received_messages              Message[]             @relation("MessageReceiver")
  sent_messages                  Message[]             @relation("MessageSender")
  migration_quarantines_resolved MigrationQuarantine[]
  notifications                  Notification[]
  staff                          Staff?
  student                        Student?
  teacher                        Teacher?
  user_roles                     UserRole[]
  campus_media                   CampusMedia[]
  faculty_attendance_corrections FacultyAttendance[]   @relation("FacultyAttendanceCorrections")
  school_settings_updated        SchoolSettings[]      @relation("SchoolSettingsUpdater")

  // Phase G: Official Calendar, Attendance, Comments, Grade Publication & SF9 Issuance relations
  calendar_months_reviewed       SchoolCalendarMonth[]      @relation("CalendarMonthReviewer")
  calendar_months_finalized      SchoolCalendarMonth[]      @relation("CalendarMonthFinalizer")
  calendar_months_reopened       SchoolCalendarMonth[]      @relation("CalendarMonthReopener")
  calendar_days_recorded         SchoolCalendarDay[]        @relation("CalendarDayRecorder")
  calendar_days_updated          SchoolCalendarDay[]        @relation("CalendarDayUpdater")
  calendar_days_approved         SchoolCalendarDay[]        @relation("CalendarDayApprover")
  section_exceptions_recorded    SectionCalendarException[] @relation("SectionExceptionRecorder")
  section_exceptions_approved    SectionCalendarException[] @relation("SectionExceptionApprover")
  official_att_recorded          OfficialDailyAttendance[]  @relation("OfficialAttRecorder")
  official_att_updated           OfficialDailyAttendance[]  @relation("OfficialAttUpdater")
  official_att_verified          OfficialDailyAttendance[]  @relation("OfficialAttVerifier")
  adviser_comments_recorded      Sf9AdviserComment[]        @relation("AdviserCommentRecorder")
  adviser_comments_updated       Sf9AdviserComment[]        @relation("AdviserCommentUpdater")
  adviser_comments_published     Sf9AdviserComment[]        @relation("AdviserCommentPublisher")
  grades_published               Grade[]                    @relation("GradePublisher")
  sf9_issuances_issued           Sf9OfficialIssuance[]      @relation("Sf9IssuanceIssuer")

  @@map("users")
}

model Role {
  id               String           @id @db.VarChar(36)
  name             String           @unique @db.VarChar(50)
  role_permissions RolePermission[]
  user_roles       UserRole[]

  @@map("roles")
}

model Permission {
  id               String           @id @db.VarChar(36)
  key              String           @unique @db.VarChar(100)
  role_permissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  role_id       String
  permission_id String
  permission    Permission @relation(fields: [permission_id], references: [id])
  role          Role       @relation(fields: [role_id], references: [id])

  @@id([role_id, permission_id])
  @@map("role_permissions")
}

model UserRole {
  user_id     String
  role_id     String
  assigned_at DateTime @default(now())
  role        Role     @relation(fields: [role_id], references: [id])
  user        User     @relation(fields: [user_id], references: [id])

  @@id([user_id, role_id])
  @@map("user_roles")
}

model Student {
  id                        String                    @id(map: "student_profiles_pkey") @db.VarChar(36)
  user_id                   String                    @unique(map: "student_profiles_user_id_key") @db.VarChar(36)
  student_number            String?                   @unique(map: "student_profiles_student_number_key") @db.VarChar(100)
  /// @encrypted?mode=strict
  lrn                       String                    @unique(map: "student_profiles_lrn_key")
  grade_level               Int
  date_of_birth             DateTime?
  gender                    String?                   @db.VarChar(10)
  /// @encrypted?mode=strict
  guardian_phone            String?
  /// @encrypted?mode=strict
  guardian_email            String?
  /// @encrypted?mode=strict
  blood_type                String?
  created_at                DateTime                  @default(now())
  updated_at                DateTime                  @updatedAt
  current_section_id        String?                   @db.VarChar(36)
  city                      String?                   @db.VarChar(100)
  guardian_first_name       String?                   @db.VarChar(100)
  guardian_last_name        String?                   @db.VarChar(100)
  state_province            String?                   @db.VarChar(100)
  street                    String?                   @db.VarChar(255)
  zip_code                  String?                   @db.VarChar(20)
  /// @encrypted?mode=strict
  allergies                 String?
  /// @encrypted?mode=strict
  medical_conditions        String?
  /// @encryption:hash(lrn)
  lrn_hash                  String?                   @unique
  appointments              Appointment[]
  behavior_logs             BehaviorLog[]
  clinic_referrals          ClinicReferral[]
  documentRequests          DocumentRequest[]
  enrollments               Enrollment[]
  excuseLetters             ExcuseLetter[]
  gate_attendance           GateAttendance[]
  grades                    Grade[]
  guidance_records          GuidanceRecord[]
  official_daily_attendance OfficialDailyAttendance[]
  sf9_adviser_comments      Sf9AdviserComment[]
  sf9_issuances             Sf9OfficialIssuance[]
  user                      User                      @relation(fields: [user_id], references: [id], map: "student_profiles_user_id_fkey")
  current_section           Section?                  @relation(fields: [current_section_id], references: [id], onDelete: Restrict)

  @@map("students")
}

model Teacher {
  id                  String                     @id(map: "teacher_profiles_pkey") @db.VarChar(36)
  user_id             String                     @unique(map: "teacher_profiles_user_id_key") @db.VarChar(36)
  employee_id         String                     @unique(map: "teacher_profiles_employee_id_key") @db.VarChar(50)
  department          String?                    @db.VarChar(100)
  position            String?                    @db.VarChar(100)
  specialization      String?                    @db.VarChar(200)
  date_hired          DateTime?
  created_at          DateTime                   @default(now())
  updated_at          DateTime                   @updatedAt
  appointments        Appointment[]
  documentRequests    DocumentRequest[]
  excuseLetters       ExcuseLetter[]
  teacherRankings     TeacherRanking[]
  assignments         TeacherSubjectAssignment[]
  faculty_attendances FacultyAttendance[]
  scan_credentials    TeacherScanCredential[]
  advised_sections    Section[]                  @relation("SectionAdviser")
  sf9_issuances       Sf9OfficialIssuance[]      @relation("Sf9IssuanceAdviser")
  user                User                       @relation(fields: [user_id], references: [id], map: "teacher_profiles_user_id_fkey")

  @@map("teachers")
}

model TeacherScanCredential {
  id              String   @id @db.VarChar(36)
  teacher_id      String   @db.VarChar(36)
  scan_identifier String   @unique(map: "teacher_scan_credentials_identifier_key") @db.VarChar(100)
  is_active       Boolean  @default(true)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  teacher         Teacher  @relation(fields: [teacher_id], references: [id], onDelete: Cascade)

  @@index([scan_identifier, is_active], map: "teacher_scan_credentials_lookup_idx")
  @@map("teacher_scan_credentials")
}

model Staff {
  id           String        @id(map: "staff_profiles_pkey") @db.VarChar(36)
  user_id      String        @unique(map: "staff_profiles_user_id_key") @db.VarChar(36)
  employee_id  String        @unique(map: "staff_profiles_employee_id_key") @db.VarChar(50)
  department   String?       @db.VarChar(100)
  position     String?       @db.VarChar(100)
  created_at   DateTime      @default(now())
  updated_at   DateTime      @updatedAt
  appointments Appointment[]
  user         User          @relation(fields: [user_id], references: [id], map: "staff_profiles_user_id_fkey")

  @@map("staff")
}

model AcademicYear {
  id                         String                     @id @db.VarChar(36)
  name                       String                     @unique @db.VarChar(50)
  start_date                 DateTime
  end_date                   DateTime
  is_current                 Boolean                    @default(false)
  created_at                 DateTime                   @default(now())
  updated_at                 DateTime                   @updatedAt
  target_enrollment          Int?
  school_head_name_snapshot  String?                    @db.VarChar(150)
  school_head_title_snapshot String?                    @db.VarChar(100)
  enrollments                Enrollment[]
  grades                     Grade[]
  sections                   Section[]
  teacherRankings            TeacherRanking[]
  assignments                TeacherSubjectAssignment[]
  terms                      Term[]
  calendar_months            SchoolCalendarMonth[]
  calendar_days              SchoolCalendarDay[]
  section_exceptions         SectionCalendarException[]
  official_daily_attendance  OfficialDailyAttendance[]
  sf9_adviser_comments       Sf9AdviserComment[]
  sf9_issuances              Sf9OfficialIssuance[]

  @@map("academic_years")
}

model Term {
  id               String       @id @db.VarChar(36)
  academic_year_id String       @db.VarChar(36)
  name             String       @db.VarChar(50)
  start_date       DateTime?
  end_date         DateTime?
  created_at       DateTime     @default(now())
  updated_at       DateTime     @updatedAt
  key              TermKey
  gradebooks       gradebooks[]
  academic_year    AcademicYear @relation(fields: [academic_year_id], references: [id])

  @@unique([academic_year_id, key])
  @@map("terms")
}

model Subject {
  id          String                     @id @db.VarChar(36)
  code        String                     @unique @db.VarChar(20)
  name        String                     @db.VarChar(100)
  created_at  DateTime                   @default(now())
  updated_at  DateTime                   @updatedAt
  grades      Grade[]
  assignments TeacherSubjectAssignment[]

  @@map("subjects")
}

model Section {
  id                        String                     @id @db.VarChar(36)
  academic_year_id          String                     @db.VarChar(36)
  name                      String                     @db.VarChar(50)
  grade_level               Int
  adviser_teacher_id        String?                    @db.VarChar(36)
  adviser_assigned_at       DateTime?
  adviser_name_snapshot     String?                    @db.VarChar(150)
  created_at                DateTime                   @default(now())
  updated_at                DateTime                   @updatedAt
  enrollments               Enrollment[]
  academic_year             AcademicYear               @relation(fields: [academic_year_id], references: [id])
  adviser_teacher           Teacher?                   @relation("SectionAdviser", fields: [adviser_teacher_id], references: [id], onDelete: Restrict)
  students                  Student[]
  assignments               TeacherSubjectAssignment[]
  calendar_exceptions       SectionCalendarException[]
  official_daily_attendance OfficialDailyAttendance[]
  sf9_adviser_comments      Sf9AdviserComment[]
  sf9_issuances             Sf9OfficialIssuance[]

  @@unique([academic_year_id, name, grade_level])
  // Composite key target so child tables can enforce (section_id, academic_year_id) consistency at DB level
  @@unique([id, academic_year_id])
  @@index([adviser_teacher_id])
  @@map("sections")
}

model TeacherSubjectAssignment {
  id                String            @id(map: "assignments_pkey") @db.VarChar(36)
  academic_year_id  String            @db.VarChar(36)
  teacher_id        String            @db.VarChar(36)
  section_id        String            @db.VarChar(36)
  subject_id        String            @db.VarChar(36)
  days              String?           @db.VarChar(50)
  start_time        String?           @db.VarChar(10)
  end_time          String?           @db.VarChar(10)
  room              String?           @db.VarChar(50)
  created_at        DateTime          @default(now())
  updated_at        DateTime          @updatedAt
  class_attendances ClassAttendance[]
  gradebooks        gradebooks[]
  academic_year     AcademicYear      @relation(fields: [academic_year_id], references: [id], map: "assignments_academic_year_id_fkey")
  section           Section           @relation(fields: [section_id], references: [id], map: "assignments_section_id_fkey")
  subject           Subject           @relation(fields: [subject_id], references: [id], map: "assignments_subject_id_fkey")
  teacher           Teacher           @relation(fields: [teacher_id], references: [id], map: "assignments_teacher_id_fkey")

  @@unique([academic_year_id, teacher_id, section_id, subject_id], map: "assignments_academic_year_id_teacher_id_section_id__key")
  @@index([teacher_id, academic_year_id], map: "assignments_teacher_id_academic_year_id_idx")
  @@map("teacher_subject_assignments")
}

model Enrollment {
  id                        String                    @id(map: "student_enrollments_pkey") @db.VarChar(36)
  academic_year_id          String                    @db.VarChar(36)
  student_id                String                    @db.VarChar(36)
  section_id                String                    @db.VarChar(36)
  status                    String                    @db.VarChar(20)
  effective_start_date      DateTime?                 @db.Date
  effective_end_date        DateTime?                 @db.Date
  created_at                DateTime                  @default(now())
  updated_at                DateTime                  @updatedAt
  class_attendances         ClassAttendance[]
  official_daily_attendance OfficialDailyAttendance[]
  sf9_adviser_comments      Sf9AdviserComment[]
  sf9_issuances             Sf9OfficialIssuance[]
  academic_year             AcademicYear              @relation(fields: [academic_year_id], references: [id], map: "student_enrollments_academic_year_id_fkey")
  // Preserves existing Prisma Client relation signature (fields: [section_id]) while SQL migration
  // additionally enforces composite FK student_enrollments_section_ay_fkey (section_id, academic_year_id)
  section                   Section                   @relation(fields: [section_id], references: [id], map: "student_enrollments_section_id_fkey")
  student                   Student                   @relation(fields: [student_id], references: [id], map: "student_enrollments_student_id_fkey")
  grade_entries             grade_entries[]

  // Composite key target so OfficialDailyAttendance & Sf9OfficialIssuance can enforce
  // (enrollment_id, student_id, section_id, academic_year_id) match at the PostgreSQL FK level
  @@unique([id, student_id, section_id, academic_year_id])
  @@index([academic_year_id, student_id], map: "student_enrollments_academic_year_id_student_id_idx")
  @@index([section_id], map: "student_enrollments_section_id_idx")
  @@map("enrollments")
}

model GateAttendance {
  id         String    @id @db.VarChar(36)
  student_id String    @db.VarChar(36)
  date       DateTime  @db.Date
  status     String    @db.VarChar(20)
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  time_in    DateTime? @db.Time(3)
  time_out   DateTime? @db.Time(3)
  student    Student   @relation(fields: [student_id], references: [id])

  @@unique([student_id, date])
  @@map("gate_attendance")
}

model ClassAttendance {
  id            String                   @id @db.VarChar(36)
  date          DateTime                 @db.Date
  status        String                   @db.VarChar(5)
  remarks       String?
  created_at    DateTime                 @default(now())
  updated_at    DateTime                 @updatedAt
  assignment_id String                   @db.VarChar(36)
  enrollment_id String                   @db.VarChar(36)
  assignment    TeacherSubjectAssignment @relation(fields: [assignment_id], references: [id])
  enrollment    Enrollment               @relation(fields: [enrollment_id], references: [id])

  @@unique([assignment_id, enrollment_id, date])
  @@map("class_attendance")
}

model Document {
  id                      String                   @id @db.VarChar(36)
  storage_key             String                   @db.VarChar(500)
  filename                String                   @db.VarChar(255)
  mime_type               String                   @db.VarChar(100)
  size_bytes              Int
  uploaded_by             String                   @db.VarChar(36)
  created_at              DateTime                 @default(now())
  document_requests       DocumentRequest[]        @relation("AttachedDocument")
  uploader                User                     @relation(fields: [uploaded_by], references: [id])
  excuseLetters           ExcuseLetter[]
  teacherRankingDocuments TeacherRankingDocument[]
  campus_media            CampusMedia?
  sf9_official_issuances  Sf9OfficialIssuance[]    @relation("IssuedSf9PdfDocument")

  @@map("documents")
}

model DocumentRequest {
  id                      String    @id @db.VarChar(36)
  student_id              String    @db.VarChar(36)
  document_type           String    @db.VarChar(100)
  purpose                 String
  status                  String    @db.VarChar(30)
  current_stage           Int       @default(1)
  submitted_date          DateTime  @default(now())
  teacher_id              String?   @db.VarChar(36)
  teacher_approved_date   DateTime?
  teacher_remarks         String?
  principal_approved_date DateTime?
  principal_remarks       String?
  ready_date              DateTime?
  attached_document_id    String?   @db.VarChar(36)
  created_at              DateTime  @default(now())
  updated_at              DateTime  @updatedAt
  principal_id            String?   @db.VarChar(36)
  attached_document       Document? @relation("AttachedDocument", fields: [attached_document_id], references: [id], onDelete: Restrict)
  principal               User?     @relation("PrincipalApprover", fields: [principal_id], references: [id], onDelete: Restrict)
  student                 Student   @relation(fields: [student_id], references: [id])
  teacher                 Teacher?  @relation(fields: [teacher_id], references: [id], onDelete: Restrict)

  @@map("document_requests")
}

model ClinicReferral {
  id             String    @id @db.VarChar(36)
  student_id     String    @db.VarChar(36)
  date           DateTime
  blood_pressure String?   @db.VarChar(20)
  heart_rate     String?   @db.VarChar(10)
  /// @encrypted?mode=strict
  notes          String?
  recorded_by    String?   @db.VarChar(36)
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt
  time           DateTime? @db.Time(3)
  temperature    Float?
  /// @encrypted?mode=strict
  diagnosis      String?
  /// @encrypted?mode=strict
  medications    String?
  /// @encrypted?mode=strict
  symptoms       String?
  /// @encrypted?mode=strict
  treatments     String?
  recorder       User?     @relation(fields: [recorded_by], references: [id], onDelete: Restrict)
  student        Student   @relation(fields: [student_id], references: [id], map: "clinic_referrals_student_id_fkey")

  @@map("clinic_referrals")
}

model GuidanceRecord {
  id             String    @id @db.VarChar(36)
  student_id     String    @db.VarChar(36)
  counselor_id   String?   @db.VarChar(36)
  date           DateTime
  type           String    @db.VarChar(50)
  /// @encrypted?mode=strict
  reason         String?
  /// @encrypted?mode=strict
  notes          String?
  /// @encrypted?mode=strict
  action_taken   String?
  follow_up_date DateTime?
  status         String    @default("Open") @db.VarChar(20)
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt
  counselor      User?     @relation(fields: [counselor_id], references: [id], onDelete: Restrict)
  student        Student   @relation(fields: [student_id], references: [id])

  @@map("guidance_records")
}

model BehaviorLog {
  id          String   @id @db.VarChar(36)
  student_id  String   @db.VarChar(36)
  type        String   @db.VarChar(50)
  date        DateTime
  status      String   @db.VarChar(50)
  note        String?
  reported_by String?  @db.VarChar(36)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  reporter    User?    @relation(fields: [reported_by], references: [id], onDelete: Restrict)
  student     Student  @relation(fields: [student_id], references: [id])

  @@map("behavior_logs")
}

model Appointment {
  id           String   @id @db.VarChar(36)
  student_id   String   @db.VarChar(36)
  parent_email String?  @db.VarChar(255)
  teacher_id   String?  @db.VarChar(36)
  date         DateTime
  purpose      String
  status       String   @default("Pending") @db.VarChar(20)
  direction    String   @db.VarChar(30)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt
  time         DateTime @db.Time(3)
  staff_id     String?  @db.VarChar(36)
  staff        Staff?   @relation(fields: [staff_id], references: [id], onDelete: Restrict)
  student      Student  @relation(fields: [student_id], references: [id])
  teacher      Teacher? @relation(fields: [teacher_id], references: [id], onDelete: Restrict)

  @@map("appointments")
}

model LeaveRequest {
  id             String   @id @db.VarChar(36)
  user_id        String   @db.VarChar(36)
  type           String   @db.VarChar(50)
  start_date     DateTime
  end_date       DateTime
  days           Int
  reason         String
  status         String   @default("Pending") @db.VarChar(20)
  submitted_on   DateTime @default(now())
  approver_note  String?
  attachment_url String?
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt
  approver_id    String?  @db.VarChar(36)
  approver       User?    @relation("LeaveApprover", fields: [approver_id], references: [id], onDelete: Restrict)
  user           User     @relation("LeaveRequester", fields: [user_id], references: [id])

  @@map("leave_requests")
}

model ExcuseLetter {
  id             String    @id @db.VarChar(36)
  student_id     String    @db.VarChar(36)
  teacher_id     String    @db.VarChar(36)
  reason         String
  document_id    String?   @db.VarChar(36)
  status         String    @default("Pending Review") @db.VarChar(30)
  teacher_note   String?
  submitted_date DateTime  @default(now())
  reviewed_at    DateTime?
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt
  end_date       DateTime  @db.Date
  start_date     DateTime  @db.Date
  document       Document? @relation(fields: [document_id], references: [id], onDelete: Restrict)
  student        Student   @relation(fields: [student_id], references: [id])
  teacher        Teacher   @relation(fields: [teacher_id], references: [id])

  @@map("excuse_letters")
}

model EnrollmentApplication {
  id           String   @id @db.VarChar(36)
  type         String   @db.VarChar(30)
  date_applied DateTime @default(now())
  status       String   @default("Pending Review") @db.VarChar(30)
  birth_cert   Boolean  @default(false)
  form138      Boolean  @default(false)
  good_moral   Boolean  @default(false)
  medical      Boolean  @default(false)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt
  grade_level  Int
  first_name   String   @db.VarChar(100)
  last_name    String   @db.VarChar(100)

  @@map("enrollment_applications")
}

model Announcement {
  id         String   @id @db.VarChar(36)
  title      String   @db.VarChar(255)
  body       String
  audience   String   @db.VarChar(50)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  author_id  String   @db.VarChar(36)
  author     User     @relation(fields: [author_id], references: [id])

  @@map("announcements")
}

model Message {
  id          String   @id @db.VarChar(36)
  sender_id   String   @db.VarChar(36)
  receiver_id String?  @db.VarChar(36)
  content     String
  is_read     Boolean  @default(false)
  created_at  DateTime @default(now())
  receiver    User?    @relation("MessageReceiver", fields: [receiver_id], references: [id], onDelete: Restrict)
  sender      User     @relation("MessageSender", fields: [sender_id], references: [id])

  @@index([sender_id])
  @@index([receiver_id])
  @@map("messages")
}

model Notification {
  id           String   @id @db.VarChar(36)
  recipient_id String   @db.VarChar(36)
  title        String   @db.VarChar(255)
  body         String
  icon_type    String   @default("alert") @db.VarChar(20)
  is_read      Boolean  @default(false)
  created_at   DateTime @default(now())
  recipient    User     @relation(fields: [recipient_id], references: [id])

