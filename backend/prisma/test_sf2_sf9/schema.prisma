// ═════════════════════════════════════════════════════════════════════════════
// PHASE G — OFFICIAL SF2 / SF9 CALENDAR, DAILY ATTENDANCE, COMMENTS & ISSUANCE
// ═════════════════════════════════════════════════════════════════════════════

enum Sf9MonthKey {
  JUN
  JUL
  AUG
  SEP
  OCT
  NOV
  DEC
  JAN
  FEB
  MAR
  APR
}

enum CalendarMonthStatus {
  DRAFT
  REVIEWED
  FINALIZED
}

enum CalendarDayType {
  INSTRUCTIONAL
  WEEKEND
  REGULAR_HOLIDAY
  SPECIAL_NON_WORKING_HOLIDAY
  CLASS_SUSPENSION
  MAKEUP_INSTRUCTIONAL
  SCHOOL_ACTIVITY_NON_INSTRUCTIONAL
}

enum CalendarDayApprovalStatus {
  DRAFT
  APPROVED
}

enum OfficialAttendanceStatus {
  P
  A
  L
  E
}

enum OfficialAttendanceRecordStatus {
  DRAFT
  VERIFIED
  INVALIDATED_NON_INSTRUCTIONAL
}

enum CommentPublicationStatus {
  DRAFT
  PUBLISHED
}

model SchoolCalendarMonth {
  id                         String              @id @db.VarChar(36)
  academic_year_id           String              @db.VarChar(36)
  month_key                  Sf9MonthKey
  calendar_year              Int
  calendar_month             Int
  status                     CalendarMonthStatus @default(DRAFT)
  planned_instructional_days Int?
  reviewed_by_id             String?             @db.VarChar(36)
  reviewed_at                DateTime?
  finalized_by_id            String?             @db.VarChar(36)
  finalized_at               DateTime?
  reopened_by_id             String?             @db.VarChar(36)
  reopened_at                DateTime?
  reopen_reason              String?             @db.VarChar(500)
  created_at                 DateTime            @default(now())
  updated_at                 DateTime            @updatedAt

  academic_year              AcademicYear        @relation(fields: [academic_year_id], references: [id], onDelete: Restrict)
  reviewed_by                User?               @relation("CalendarMonthReviewer", fields: [reviewed_by_id], references: [id], onDelete: Restrict)
  finalized_by               User?               @relation("CalendarMonthFinalizer", fields: [finalized_by_id], references: [id], onDelete: Restrict)
  reopened_by                User?               @relation("CalendarMonthReopener", fields: [reopened_by_id], references: [id], onDelete: Restrict)
  calendar_days              SchoolCalendarDay[]

  @@unique([academic_year_id, month_key])
  @@unique([academic_year_id, calendar_year, calendar_month])
  // Composite key target so SchoolCalendarDay can enforce (calendar_month_id, academic_year_id) match at DB level
  @@unique([id, academic_year_id])
  @@index([academic_year_id, status])
  @@map("school_calendar_months")
}

model SchoolCalendarDay {
  id                  String                    @id @db.VarChar(36)
  academic_year_id    String                    @db.VarChar(36)
  calendar_month_id   String                    @db.VarChar(36)
  date                DateTime                  @db.Date
  day_type            CalendarDayType
  is_instructional    Boolean                   @default(false)
  description         String?                   @db.VarChar(255)
  approval_status     CalendarDayApprovalStatus @default(DRAFT)
  recorded_by_id      String                    @db.VarChar(36)
  updated_by_id       String?                   @db.VarChar(36)
  approved_by_id      String?                   @db.VarChar(36)
  approved_at         DateTime?
  correction_reason   String?                   @db.VarChar(500)
  created_at          DateTime                  @default(now())
  updated_at          DateTime                  @updatedAt

  academic_year       AcademicYear              @relation(fields: [academic_year_id], references: [id], onDelete: Restrict)
  // Enforces at DB level that calendar_month_id belongs to the exact same academic_year_id
  calendar_month      SchoolCalendarMonth       @relation(fields: [calendar_month_id, academic_year_id], references: [id, academic_year_id], onDelete: Restrict)
  recorded_by         User                      @relation("CalendarDayRecorder", fields: [recorded_by_id], references: [id], onDelete: Restrict)
  updated_by          User?                     @relation("CalendarDayUpdater", fields: [updated_by_id], references: [id], onDelete: Restrict)
  approved_by         User?                     @relation("CalendarDayApprover", fields: [approved_by_id], references: [id], onDelete: Restrict)
  section_exceptions  SectionCalendarException[]
  official_attendance OfficialDailyAttendance[]

  @@unique([academic_year_id, date])
  // Composite key target so child tables enforce (calendar_day_id, academic_year_id, date) match at DB level
  @@unique([id, academic_year_id, date])
  @@index([calendar_month_id, is_instructional, approval_status])
  @@map("school_calendar_days")
}

model SectionCalendarException {
  id                        String                    @id @db.VarChar(36)
  academic_year_id          String                    @db.VarChar(36)
  section_id                String                    @db.VarChar(36)
  calendar_day_id           String                    @db.VarChar(36)
  date                      DateTime                  @db.Date
  override_day_type         CalendarDayType
  override_is_instructional Boolean
  reason                    String                    @db.VarChar(500)
  approval_status           CalendarDayApprovalStatus @default(DRAFT)
  recorded_by_id            String                    @db.VarChar(36)
  approved_by_id            String?                   @db.VarChar(36)
  approved_at               DateTime?
  created_at                DateTime                  @default(now())
  updated_at                DateTime                  @updatedAt

  academic_year             AcademicYear              @relation(fields: [academic_year_id], references: [id], onDelete: Restrict)
  // Enforces at DB level that section_id belongs to the exact same academic_year_id
  section                   Section                   @relation(fields: [section_id, academic_year_id], references: [id, academic_year_id], onDelete: Restrict)
  // Enforces at DB level that calendar_day_id belongs to the exact same academic_year_id and date
  calendar_day              SchoolCalendarDay         @relation(fields: [calendar_day_id, academic_year_id, date], references: [id, academic_year_id, date], onDelete: Restrict)
  recorded_by               User                      @relation("SectionExceptionRecorder", fields: [recorded_by_id], references: [id], onDelete: Restrict)
  approved_by               User?                     @relation("SectionExceptionApprover", fields: [approved_by_id], references: [id], onDelete: Restrict)

  @@unique([section_id, calendar_day_id])
  @@unique([academic_year_id, section_id, date])
  @@index([calendar_day_id, approval_status])
  @@map("section_calendar_exceptions")
}

model OfficialDailyAttendance {
  id                String                         @id @db.VarChar(36)
  academic_year_id  String                         @db.VarChar(36)
  section_id        String                         @db.VarChar(36)
  student_id        String                         @db.VarChar(36)
  enrollment_id     String                         @db.VarChar(36)
  calendar_day_id   String                         @db.VarChar(36)
  date              DateTime                       @db.Date
  status            OfficialAttendanceStatus
  record_status     OfficialAttendanceRecordStatus @default(DRAFT)
  tardy_type        String?                        @db.VarChar(30)
  remarks           String?                        @db.VarChar(500)
  correction_reason String?                        @db.VarChar(500)
  recorded_by_id    String                         @db.VarChar(36)
  updated_by_id     String?                        @db.VarChar(36)
  verified_by_id    String?                        @db.VarChar(36)
  verified_at       DateTime?
  created_at        DateTime                       @default(now())
  updated_at        DateTime                       @updatedAt

  academic_year     AcademicYear                   @relation(fields: [academic_year_id], references: [id], onDelete: Restrict)
  section           Section                        @relation(fields: [section_id, academic_year_id], references: [id, academic_year_id], onDelete: Restrict)
  student           Student                        @relation(fields: [student_id], references: [id], onDelete: Restrict)
  // Composite FK enforces at DB level that enrollment_id matches student_id, section_id, and academic_year_id
  enrollment        Enrollment                     @relation(fields: [enrollment_id, student_id, section_id, academic_year_id], references: [id, student_id, section_id, academic_year_id], onDelete: Restrict)
  // Composite FK enforces at DB level that calendar_day_id matches academic_year_id and date
  calendar_day      SchoolCalendarDay              @relation(fields: [calendar_day_id, academic_year_id, date], references: [id, academic_year_id, date], onDelete: Restrict)
  recorded_by       User                           @relation("OfficialAttRecorder", fields: [recorded_by_id], references: [id], onDelete: Restrict)
  updated_by        User?                          @relation("OfficialAttUpdater", fields: [updated_by_id], references: [id], onDelete: Restrict)
  verified_by       User?                          @relation("OfficialAttVerifier", fields: [verified_by_id], references: [id], onDelete: Restrict)

  @@unique([enrollment_id, date])
  @@unique([student_id, date])
  @@unique([enrollment_id, calendar_day_id])
  @@index([academic_year_id, section_id, date])
  @@index([enrollment_id, record_status, date])
  @@map("official_daily_attendance")
}

model Sf9AdviserComment {
  id                String                   @id @db.VarChar(36)
  enrollment_id     String                   @db.VarChar(36)
  student_id        String                   @db.VarChar(36)
  section_id        String                   @db.VarChar(36)
  academic_year_id  String                   @db.VarChar(36)
